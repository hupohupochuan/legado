{
  "name": "legado-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" -- && node ./scripts/sync.js",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "test:chapter-progress": "node ./scripts/chapter-reading-progress.test.mjs",
    "test:page-turn-keys": "node ./scripts/page-turn-key-buffer.test.mjs",
    "test:read-time": "node ./scripts/read-time-tracker.test.mjs",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@vueuse/core": "^14.4.0",
    "@vueuse/shared": "^14.4.0",
    "hotkeys-js": "^4.0.7",
    "pinia": "^3.0.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "vue3-virtual-scroll-list": "^0.2.1"
  },
  "devDependencies": {
    "@tsconfig/node20": "^20.1.10",
    "@types/node": "^20.19.43",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.10.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.9.6",
    "sass-embedded": "^1.104.0",
    "typescript": "~5.9.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.2",
    "vue-tsc": "^3.3.11"
  }
}
